{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.mjs"
  },
  "dependencies": {
    "@hono/trpc-server": "^0.4.2",
    "@nivlak/api": "workspace:*",
    "@nivlak/auth": "workspace:*",
    "@nivlak/db": "workspace:*",
    "@nivlak/env": "workspace:*",
    "@trpc/server": "catalog:",
    "better-auth": "catalog:",
    "cors": "^2.8.6",
    "dotenv": "catalog:",
    "express": "^5.2.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nivlak/config": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "catalog:",
    "@types/node": "^22.20.1",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "typescript": "catalog:"
  }
}
